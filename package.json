{
  "name": "jarvis-ide-enhancer",
  "displayName": "JARVIS IDE Enhancer",
  "description": "Enhance VS Code with JARVIS 3D cursor, chat styles, prompt slash intellisense, and UI automation.",
  "version": "1.1.13",
  "publisher": "minhtalent-dev",
  "author": "minh <minh.tuthienbao@vn.sharp-world.com>",
  "license": "MIT",
  "icon": "assets/icon.png",
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "jarvis",
    "cursor",
    "chat",
    "copilot",
    "custom-css",
    "style",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/minhtalent-dev/jarvis-ide-enhancer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "JARVIS IDE Enhancer",
      "properties": {
        "jarvisEnhancer.customCSS": {
          "type": "string",
          "default": "",
          "description": "Custom CSS rules to override or extend JARVIS styles. Automatically synced across devices via GitHub Settings Sync.",
          "editPresentation": "multilineText",
          "scope": "application"
        },
        "jarvisEnhancer.customJS": {
          "type": "string",
          "default": "",
          "description": "Custom JS scripts to override or extend JARVIS behaviors. Automatically synced across devices via GitHub Settings Sync.",
          "editPresentation": "multilineText",
          "scope": "application"
        },
        "jarvisEnhancer.enableSelfHealing": {
          "type": "boolean",
          "default": true,
          "description": "Automatically repair patches and styling after VS Code updates."
        },
        "jarvisEnhancer.enableBacktickAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable interactive autocomplete popup for founder macro commands in Chat Input."
        },
        "jarvisEnhancer.customMacros": {
          "type": "array",
          "default": [],
          "description": "Custom founder macro abbreviations synchronized across devices.",
          "items": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            }
          }
        },
        "jarvisEnhancer.enableMacroAutoDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Automatically discover macro rules from .instructions.md files."
        }
      }
    },
    "commands": [
      {
        "command": "jarvisEnhancer.syncSetup",
        "title": "Sync Setup & Apply Styles",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.discoverMacros",
        "title": "JARVIS: Discover Macros & Sync Settings",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.patchIntellisense",
        "title": "Patch Chat Slash Intellisense",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.editCSS",
        "title": "Edit Custom CSS",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.editJS",
        "title": "Edit Custom JS",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.runSelfHealing",
        "title": "JARVIS: Run Self-Healing & Verify Patches",
        "category": "JARVIS"
      }
    ]
  },
  "scripts": {
    "lint": "node --check extension.js"
  }
}