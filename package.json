{
  "name": "jarvis-ide-enhancer",
  "displayName": "JARVIS IDE Enhancer",
  "description": "Enhance VS Code with JARVIS 3D cursor, chat styles, prompt slash intellisense, and UI automation.",
  "version": "1.2.2",
  "publisher": "minhtalent-dev",
  "author": "minh <baominh20398@gmail.com>",
  "license": "MIT",
  "icon": "assets/icon.png",
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "jarvis",
    "cursor",
    "chat",
    "copilot",
    "custom-css",
    "style",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/minhtalent-dev/jarvis-ide-enhancer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "JARVIS IDE Enhancer",
      "properties": {
        "jarvisEnhancer.customCSS": {
          "type": "string",
          "default": "",
          "description": "Custom CSS rules to override or extend JARVIS styles. Automatically synced across devices via GitHub Settings Sync.",
          "editPresentation": "multilineText",
          "scope": "application"
        },
        "jarvisEnhancer.customJS": {
          "type": "string",
          "default": "",
          "description": "Custom JS scripts to override or extend JARVIS behaviors. Automatically synced across devices via GitHub Settings Sync.",
          "editPresentation": "multilineText",
          "scope": "application"
        },
        "jarvisEnhancer.enableSelfHealing": {
          "type": "boolean",
          "default": true,
          "description": "Automatically repair patches and styling after VS Code updates."
        },
        "jarvisEnhancer.enableBacktickAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable interactive autocomplete popup for founder macro commands in Chat Input."
        },
        "jarvisEnhancer.customMacros": {
          "type": "array",
          "default": [],
          "description": "Custom founder macro abbreviations synchronized across devices.",
          "items": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            }
          }
        },
        "jarvisEnhancer.enableMacroAutoDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Automatically discover macro rules from .instructions.md files."
        },
        "jarvisEnhancer.cloudVaultPayload": {
          "type": "string",
          "default": "",
          "description": "Encrypted AES-256-GCM Agent Customizations Vault payload automatically synchronized across machines via GitHub Settings Sync.",
          "scope": "application"
        },
        "jarvisEnhancer.autoSyncCloudVault": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect and prompt to restore encrypted customizations from Cloud Settings Sync on startup."
        }
      }
    },
    "commands": [
      {
        "command": "jarvisEnhancer.masterRestore",
        "title": "Master Sync & Patch All (One-Click Restore)",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.newLocalChat",
        "title": "New Local Chat (Allow All)",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.discoverMacros",
        "title": "Discover Macros & Sync Settings",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.editCSS",
        "title": "Edit Custom CSS",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.editJS",
        "title": "Edit Custom JS",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.exportVault",
        "title": "Export Agent Customizations Vault",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.importVault",
        "title": "Import Agent Customizations Vault",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.pushCloudVault",
        "title": "Push Agent Customizations to Cloud (Settings Sync)",
        "category": "JARVIS"
      },
      {
        "command": "jarvisEnhancer.pullCloudVault",
        "title": "Pull & Restore Agent Customizations from Cloud",
        "category": "JARVIS"
      }
    ]
  },
  "scripts": {
    "lint": "node --check extension.js",
    "patch-all": "node patch_all.js",
    "package": "npx -y @vscode/vsce package --no-dependencies",
    "build": "node build_and_install.js",
    "install-ext": "node build_and_install.js"
  }
}